[Unit]
Description=Panopticon reviewed private document candidate queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=panopticon
Group=panopticon
WorkingDirectory=/srv/panopticon/repo
EnvironmentFile=/etc/panopticon/panopticon.env
ExecStart=/srv/panopticon/repo/deploy/selfhost/collect-candidates.sh
StateDirectory=panopticon
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/panopticon
