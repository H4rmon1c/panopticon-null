[Unit]
Description=Discover and screen preliminary Colorado public records
After=network-online.target
Wants=network-online.target
OnSuccess=panopticon-publish.service
OnFailure=panopticon-publish.service

[Service]
Type=oneshot
User=panopticon
Group=panopticon
WorkingDirectory=/srv/panopticon/repo
EnvironmentFile=/etc/panopticon/panopticon.env
ExecStart=/usr/bin/python3 /srv/panopticon/repo/deploy/selfhost/run-stage.py research -- /srv/panopticon/repo/deploy/selfhost/research.sh
StateDirectory=panopticon
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
TemporaryFileSystem=/tmp:rw,nosuid,nodev,size=512M,nr_inodes=32768,mode=1777
TemporaryFileSystem=/var/tmp:rw,nosuid,nodev,size=32M,nr_inodes=4096,mode=1777
Environment=TMPDIR=/tmp
NoNewPrivileges=true
ReadWritePaths=/var/lib/panopticon /srv/panopticon/status
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
TasksMax=128
MemoryMax=4G
TimeoutStartSec=90min
TimeoutStopSec=30s
