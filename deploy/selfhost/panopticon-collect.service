[Unit]
Description=Panopticon official source collection
After=network-online.target
Wants=network-online.target

OnSuccess=panopticon-candidates.service
OnFailure=panopticon-candidates.service

[Service]
Type=oneshot
User=panopticon
Group=panopticon
WorkingDirectory=/srv/panopticon/repo
EnvironmentFile=/etc/panopticon/panopticon.env
ExecStart=/usr/bin/python3 /srv/panopticon/repo/deploy/selfhost/run-stage.py collect -- /srv/panopticon/repo/deploy/selfhost/collect.sh
StateDirectory=panopticon
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
TemporaryFileSystem=/tmp:rw,nosuid,nodev,size=512M,nr_inodes=32768,mode=1777
TemporaryFileSystem=/var/tmp:rw,nosuid,nodev,size=32M,nr_inodes=4096,mode=1777
Environment=TMPDIR=/tmp
NoNewPrivileges=true
ReadWritePaths=/var/lib/panopticon /srv/panopticon/status
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictRealtime=true
LimitNOFILE=4096
TasksMax=128
MemoryMax=4G
TimeoutStartSec=90min
TimeoutStopSec=30s
