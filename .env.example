# Copy this file outside version control and set values only at runtime.
# X_BEARER_TOKEN is intentionally unset.
# PNUL_X_SECRET_FILE may point to a mode-0600 file containing the token.
PNUL_DATA_DIR=.pnull
# Use absolute paths when running pnull outside the repository root.
PNUL_CONFIG_PATH=configs/states/co.toml
PNUL_RULES_PATH=rules/surveillance.yml
# Optional override for canonical links; set this to the deployed site URL.
PNUL_SITE_URL=https://example.invalid/co
